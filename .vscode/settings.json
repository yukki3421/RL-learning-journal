{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": true,
  "git.autofetch": false,
  "git.autoRepositoryDetection": "subFolders",
  "git.openRepositoryInParentFolders": "never",
  "files.exclude": {
    "**/__pycache__": true,
    ".uv-cache": true
  },
  "search.exclude": {
    ".uv-cache": true,
    ".venv": true
  }
}
